{
  "name": "automation-studio",
  "displayName": "Automation Studio",
  "description": "Visual web and Surface test automation with shared Playwright libraries, code generation, repeatable runs, and embedded HTML reports",
  "icon": "assets/record-button.png",
  "version": "0.2.11",
  "publisher": "automationstudio",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/samudralasrikanth/automation-studio"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "Playwright",
    "visual testing",
    "Surface automation",
    "flow builder",
    "test reports",
    "Gherkin"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:watch": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist out",
    "package": "pnpm run build && rm -rf node_modules runtime-dependencies && cp package.json package.json.tmp && node -e \"const fs = require('fs'); const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8')); delete pkg.devDependencies; fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2));\" && npm install --omit=dev && node scripts/stage-runtime-dependencies.mjs && (npx -y @vscode/vsce package --no-dependencies --allow-missing-repository; status=$?; rm -rf runtime-dependencies; mv package.json.tmp package.json; pnpm install; exit $status)",
    "vsix": "npm run package"
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "automationstudio",
        "name": "automationstudio",
        "fullName": "Automation Studio",
        "description": "Build and analyze unified PW and Surface automation assets from Copilot Chat.",
        "isSticky": true
      },
      {
        "id": "automatiostudio",
        "name": "automatiostudio",
        "fullName": "Automation Studio (alias)",
        "description": "Automation Studio assistant alias.",
        "isSticky": false
      }
    ],
    "languageModelTools": [
      {
        "name": "automationStudio_build_object_repository",
        "displayName": "Build Automation Studio Object Repository",
        "userDescription": "Build or preview the unified Object Repository from saved Automation Studio scenarios.",
        "toolReferenceName": "buildObjectRepository",
        "icon": "$(references)",
        "canBeReferencedInPrompt": true,
        "tags": [
          "automation",
          "object repository",
          "playwright",
          "surface"
        ],
        "modelDescription": "Scan the current Automation Studio project scenarios and build a unified Object Repository containing reusable PW and Surface locators. Default to preview mode. Set write=true only when the user explicitly asks to save or update project files.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectPath": {
              "type": "string",
              "description": "Optional current Automation Studio project path."
            },
            "scenarioPath": {
              "type": "string",
              "description": "Optional scenario JSON file or folder relative to the project."
            },
            "mode": {
              "type": "string",
              "enum": [
                "pw",
                "surface",
                "all"
              ],
              "description": "Locator family to include."
            },
            "write": {
              "type": "boolean",
              "description": "Write generated objects to automation/object-repository. Use only after explicit user confirmation."
            }
          }
        }
      },
      {
        "name": "automationStudio_analyze_object",
        "displayName": "Analyze Automation Studio Object",
        "userDescription": "Inspect an object and propose manual locator corrections.",
        "toolReferenceName": "analyzeAutomationObject",
        "icon": "$(search)",
        "canBeReferencedInPrompt": true,
        "tags": [
          "automation",
          "object repository",
          "locator",
          "healing"
        ],
        "modelDescription": "Inspect an existing unified Automation Studio object and return its PW locator, Surface evidence, screenshot metadata, and proposed manual corrections. Set write=true only when the user explicitly asks to apply a correction.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectPath": {
              "type": "string",
              "description": "Optional current Automation Studio project path."
            },
            "objectId": {
              "type": "string",
              "description": "Object URI such as object://app.login.username."
            },
            "write": {
              "type": "boolean",
              "description": "Apply the correction to the object repository."
            },
            "correction": {
              "type": "object",
              "description": "Optional fields to correct: name, type, description, tags, pw, surface, or screenshot."
            }
          },
          "required": [
            "objectId"
          ]
        }
      },
      {
        "name": "automationStudio_generate_gherkin_hierarchy",
        "displayName": "Generate Automation Studio Gherkin",
        "userDescription": "Turn test-case text or a referenced file into a readable Gherkin hierarchy.",
        "toolReferenceName": "generateAutomationGherkin",
        "icon": "$(list-tree)",
        "canBeReferencedInPrompt": true,
        "tags": [
          "automation",
          "gherkin",
          "bdd",
          "test case"
        ],
        "modelDescription": "Convert test-case text or a project file into a Feature, Scenario, Given/When/Then hierarchy. Default to preview mode and write the .feature file only when the user explicitly asks to save it.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectPath": {
              "type": "string",
              "description": "Optional current Automation Studio project path."
            },
            "text": {
              "type": "string",
              "description": "Test case or acceptance criteria text."
            },
            "filePath": {
              "type": "string",
              "description": "Project-relative test-case file path."
            },
            "scenarioName": {
              "type": "string",
              "description": "Optional feature/scenario name."
            },
            "write": {
              "type": "boolean",
              "description": "Save the generated feature file to automation/scenarios."
            }
          }
        }
      },
      {
        "name": "automationStudio_requirements_to_tests",
        "displayName": "Generate Tests from Requirements",
        "userDescription": "Turn natural language requirements into automated scenarios and Gherkin features.",
        "toolReferenceName": "requirementsToTests",
        "icon": "$(checklist)",
        "canBeReferencedInPrompt": true,
        "tags": [
          "automation",
          "tests",
          "requirements",
          "generation"
        ],
        "modelDescription": "Parse requirement text and generate a scenario and Gherkin feature file. Default to preview mode and write the files only when explicitly asked.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectPath": {
              "type": "string",
              "description": "Optional current Automation Studio project path."
            },
            "text": {
              "type": "string",
              "description": "Requirement or user story text."
            },
            "filePath": {
              "type": "string",
              "description": "Optional file path containing the requirements."
            },
            "mode": {
              "type": "string",
              "enum": [
                "pw",
                "surface"
              ],
              "description": "Target engine mode."
            },
            "scenarioName": {
              "type": "string",
              "description": "Optional scenario name."
            },
            "write": {
              "type": "boolean",
              "description": "Save generated scenarios to the project."
            }
          }
        }
      },
      {
        "name": "automationStudio_test_design",
        "displayName": "Design Test Strategy",
        "userDescription": "Analyze the project and suggest a test coverage strategy.",
        "toolReferenceName": "testDesign",
        "icon": "$(lightbulb)",
        "canBeReferencedInPrompt": true,
        "tags": [
          "automation",
          "strategy",
          "coverage",
          "planning"
        ],
        "modelDescription": "Analyze existing scenarios to build a coverage matrix and suggest new scenarios based on gaps.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectPath": {
              "type": "string",
              "description": "Optional current Automation Studio project path."
            },
            "scope": {
              "type": "string",
              "description": "Specific feature scope to analyze."
            },
            "coverageGoal": {
              "type": "string",
              "enum": [
                "smoke",
                "regression",
                "full"
              ],
              "description": "Target coverage level."
            },
            "includeEdgeCases": {
              "type": "boolean",
              "description": "Whether to include edge cases in the suggestions."
            }
          }
        }
      },
      {
        "name": "automationStudio_rca",
        "displayName": "Root Cause Analysis",
        "userDescription": "Analyze a test failure and suggest a fix.",
        "toolReferenceName": "rootCauseAnalysis",
        "icon": "$(bug)",
        "canBeReferencedInPrompt": true,
        "tags": [
          "automation",
          "rca",
          "debug",
          "failure"
        ],
        "modelDescription": "Load a recent execution report, classify the failure reason, explain the root cause, and suggest a fix.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectPath": {
              "type": "string",
              "description": "Optional current Automation Studio project path."
            },
            "executionId": {
              "type": "string",
              "description": "Specific execution ID to analyze, otherwise latest."
            },
            "reportPath": {
              "type": "string",
              "description": "Specific report file path."
            }
          }
        }
      },
      {
        "name": "automationStudio_self_heal",
        "displayName": "Self-Heal Locators",
        "userDescription": "Automatically repair broken locators from recent test failures.",
        "toolReferenceName": "selfHeal",
        "icon": "$(wand)",
        "canBeReferencedInPrompt": true,
        "tags": [
          "automation",
          "healing",
          "locator",
          "maintenance"
        ],
        "modelDescription": "Scan recent failure reports for broken locators and generate alternative locators (e.g. data-testid, roles). Default to preview (dryRun=true).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectPath": {
              "type": "string",
              "description": "Optional current Automation Studio project path."
            },
            "scenarioPath": {
              "type": "string",
              "description": "Specific scenario to heal, otherwise all."
            },
            "failedStepId": {
              "type": "string",
              "description": "Specific step to heal."
            },
            "dryRun": {
              "type": "boolean",
              "description": "If true, only preview. If false, apply changes to files."
            },
            "write": {
              "type": "boolean",
              "description": "If true, apply changes (same as dryRun=false)."
            }
          }
        }
      },
      {
        "name": "automationStudio_release_readiness",
        "displayName": "Assess Release Readiness",
        "userDescription": "Evaluate test pass rates and flaky tests to determine release readiness.",
        "toolReferenceName": "releaseReadiness",
        "icon": "$(check-all)",
        "canBeReferencedInPrompt": true,
        "tags": [
          "automation",
          "release",
          "quality",
          "metrics"
        ],
        "modelDescription": "Analyze test execution history across the project to calculate pass rates, detect flaky tests, and provide a GO/NO_GO verdict.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectPath": {
              "type": "string",
              "description": "Optional current Automation Studio project path."
            },
            "passThreshold": {
              "type": "number",
              "description": "Required pass rate percentage (default 95)."
            },
            "maxFlakyPercent": {
              "type": "number",
              "description": "Maximum allowed flaky test percentage (default 5)."
            }
          }
        }
      },
      {
        "name": "automationStudio_orchestrate",
        "displayName": "Run Multi-Agent Pipeline",
        "userDescription": "Run multiple AI agents in sequence (e.g., heal → rca → readiness).",
        "toolReferenceName": "orchestrateAgents",
        "icon": "$(circuit-board)",
        "canBeReferencedInPrompt": true,
        "tags": [
          "automation",
          "pipeline",
          "orchestration",
          "agents"
        ],
        "modelDescription": "Run a sequence of agents and summarize their results. Useful for full project maintenance sweeps.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectPath": {
              "type": "string",
              "description": "Optional current Automation Studio project path."
            },
            "pipeline": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "requirements",
                  "design",
                  "heal",
                  "rca",
                  "readiness"
                ]
              },
              "description": "Array of agent names to run."
            },
            "write": {
              "type": "boolean",
              "description": "Allow agents to save changes to the project."
            }
          }
        }
      }
    ],
    "commands": [
      {
        "command": "automationStudio.runScenario",
        "title": "Run Scenario",
        "category": "Automation Studio",
        "icon": "$(play)"
      },
      {
        "command": "automationStudio.debugScenario",
        "title": "Debug Scenario",
        "category": "Automation Studio",
        "icon": "$(debug-alt)"
      },
      {
        "command": "automationStudio.showReport",
        "title": "Show Report",
        "category": "Automation Studio",
        "icon": "$(report)"
      },
      {
        "command": "automationStudio.frameworkManager.show",
        "title": "Open Framework Manager",
        "category": "Automation Studio",
        "icon": "$(extensions)"
      },
      {
        "command": "automationStudio.stopExecution",
        "title": "Stop Execution",
        "category": "Automation Studio",
        "icon": "$(stop)"
      },
      {
        "command": "automationStudio.deleteProject",
        "title": "Delete Project",
        "category": "Automation Studio",
        "icon": "$(trash)"
      },
      {
        "command": "automationStudio.showLogs",
        "title": "Show Logs",
        "category": "Automation Studio"
      },
      {
        "command": "automationStudio.secret.store",
        "title": "Store or Update Hidden Secret",
        "category": "Automation Studio",
        "icon": "$(key)"
      },
      {
        "command": "automationStudio.secret.delete",
        "title": "Delete Hidden Secret",
        "category": "Automation Studio",
        "icon": "$(trash)"
      },
      {
        "command": "automationStudio.showVersion",
        "title": "Show Version",
        "category": "Automation Studio"
      },
      {
        "command": "automationStudio.reloadConfiguration",
        "title": "Reload Configuration",
        "category": "Automation Studio"
      },
      {
        "command": "automationStudio.checkHealth",
        "title": "Check Health",
        "category": "Automation Studio"
      },
      {
        "command": "automationStudio.doctor",
        "title": "Run Runtime Doctor",
        "category": "Automation Studio",
        "icon": "$(beaker)"
      },
      {
        "command": "automationStudio.ai.generateScenario",
        "title": "Automation Studio: Generate Scenario with AI",
        "category": "Automation Studio"
      },
      {
        "command": "automationStudio.project.create",
        "title": "Create Project",
        "category": "Automation Studio",
        "icon": "$(add)"
      },
      {
        "command": "automationStudio.project.open",
        "title": "Open Project",
        "category": "Automation Studio",
        "icon": "$(folder-opened)"
      },
      {
        "command": "automationStudio.project.close",
        "title": "Close Project",
        "category": "Automation Studio"
      },
      {
        "command": "automationStudio.project.reload",
        "title": "Reload Project",
        "category": "Automation Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "automationStudio.settings.open",
        "title": "Open Settings",
        "category": "Automation Studio",
        "icon": "$(settings-gear)"
      },
      {
        "command": "automationStudio.scenario.create",
        "title": "Create Scenario",
        "category": "Automation Studio",
        "icon": "$(file-add)"
      },
      {
        "command": "automationStudio.openResource",
        "title": "Open",
