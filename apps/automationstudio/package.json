        "icon": "$(play)"
      },
      {
        "command": "automationStudio.recorder.stop",
        "title": "Stop Recording",
        "category": "Automation Studio",
        "icon": "$(primitive-square)"
      },
      {
        "command": "automationStudio.recorder.cancel",
        "title": "Cancel Recording",
