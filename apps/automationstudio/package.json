      },
      {
        "command": "automationStudio.bitwarden.disconnect",
        "title": "Disconnect Bitwarden Session",
        "category": "Automation Studio"
      }
    ],
    "keybindings": [
      {
        "command": "automationStudio.startInspector",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "automationStudio.startInspector",
          "group": "automation-studio",
          "when": "editorTextFocus"
        }
      ],
      "view/item/context": [
        {
          "command": "automationStudio.openResource",
          "when": "view == automationStudio.projectExplorer && (viewItem == project || viewItem == scenario || viewItem == folder || viewItem == scenarioFolder || viewItem == reportFolder || viewItem == file)",
          "group": "resource@1"
        },
        {
          "command": "automationStudio.scenario.create",
          "when": "view == automationStudio.projectExplorer && (viewItem == project || viewItem == scenarioFolder)",
          "group": "resource@2"
        },
        {
          "command": "automationStudio.renameResource",
          "when": "view == automationStudio.projectExplorer && (viewItem == project || viewItem == scenario || viewItem == folder || viewItem == scenarioFolder || viewItem == reportFolder || viewItem == file)",
          "group": "resource@3"
        },
        {
          "command": "automationStudio.revealResource",
          "when": "view == automationStudio.projectExplorer && (viewItem == project || viewItem == scenario || viewItem == folder || viewItem == scenarioFolder || viewItem == reportFolder || viewItem == file)",
          "group": "resource@4"
        },
        {
          "command": "automationStudio.deleteResource",
          "when": "view == automationStudio.projectExplorer && (viewItem == scenario || viewItem == folder || viewItem == scenarioFolder || viewItem == reportFolder || viewItem == file)",
          "group": "inline@3"
        },
        {
          "command": "automationStudio.runScenario",
          "when": "viewItem == scenario",
          "group": "inline@1"
        },
        {
          "command": "automationStudio.debugScenario",
          "when": "viewItem == scenario",
          "group": "inline@2"
        },
        {
          "command": "automationStudio.deleteProject",
          "when": "viewItem == project",
          "group": "inline@1"
        }
      ],
      "view/title": [
        {
          "command": "automationStudio.ai.generateScenario",
          "when": "view == automationStudio.projectExplorer",
          "group": "project@1"
        },
        {
          "command": "automationStudio.project.create",
          "when": "view == automationStudio.projectExplorer",
          "group": "navigation@1"
        },
        {
          "command": "automationStudio.project.open",
          "when": "view == automationStudio.projectExplorer",
          "group": "navigation@2"
        },
        {
          "command": "automationStudio.flowBuilder.show",
          "when": "view == automationStudio.projectExplorer",
          "group": "navigation@3"
        },
        {
          "command": "automationStudio.settings.open",
          "when": "view == automationStudio.projectExplorer",
          "group": "navigation@4"
        },
        {
          "command": "automationStudio.recorder.start",
          "when": "view == automationStudio.projectExplorer && automationStudio.recordingState != recording && automationStudio.recordingState != paused",
          "group": "navigation@4"
        },
        {
          "command": "automationStudio.recorder.pause",
          "when": "view == automationStudio.projectExplorer && automationStudio.recordingState == recording",
          "group": "navigation@5"
        },
        {
          "command": "automationStudio.recorder.resume",
          "when": "view == automationStudio.projectExplorer && automationStudio.recordingState == paused",
          "group": "navigation@6"
        },
        {
          "command": "automationStudio.recorder.stop",
          "when": "view == automationStudio.projectExplorer && (automationStudio.recordingState == recording || automationStudio.recordingState == paused)",
          "group": "navigation@7"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "automationStudio.scenarioEditor",
        "displayName": "Scenario Editor",
        "selector": [
          {
            "filenamePattern": "*.scenario.json"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "automation-studio-explorer",
          "title": "Automation Studio",
          "icon": "assets/record-button.png"
        }
      ],
      "panel": [
        {
          "id": "automationStudio",
          "title": "Automation Studio",
          "icon": "assets/record-button.png"
        }
      ]
    },
    "views": {
      "automation-studio-explorer": [
        {
          "id": "automationStudio.projectExplorer",
          "name": "Project Explorer",
          "icon": "$(folder)"
        },
        {
          "id": "automationStudio.objectRepository",
          "name": "Object Repository",
          "type": "webview",
          "icon": "$(repo)"
        },
        {
          "id": "automationStudio.environmentHealth",
          "name": "Environment Health",
          "icon": "$(pulse)"
        },
        {
          "id": "automationStudio.flowBuilderLauncher",
          "name": "Automation Studio Builder",
          "icon": "$(type-hierarchy-sub)"
        }
      ],
      "automationStudio": [
        {
          "type": "webview",
          "id": "automationStudio.consoleView",
          "name": "Output Console",
          "icon": "assets/record-button.png"
        }
      ]
    },
    "debuggers": [
      {
        "type": "automation-studio",
        "label": "Automation Studio Scenario",
        "configurationAttributes": {
          "launch": {
            "required": [
              "scenarioPath"
            ],
            "properties": {
              "scenarioPath": {
                "type": "string",
                "description": "Absolute path to the .scenario.json file",
                "default": "${file}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "automation-studio",
            "request": "launch",
            "name": "Debug Current Scenario",
            "scenarioPath": "${file}"
          }
        ]
      }
    ],
    "configuration": {
      "title": "Automation Studio",
      "properties": {
        "automationStudio.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the Python interpreter"
        },
        "automationStudio.developerMode": {
          "type": "string",
          "enum": [
            "normal",
            "developer",
            "diagnostic"
          ],
          "default": "normal",
          "description": "Control the depth of IPC and execution events tracing"
        },
        "automationStudio.logging.level": {
          "type": "string",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error",
            "fatal"
          ],
          "default": "info",
          "description": "Logging level"
        },
        "automationStudio.recorder.captureScreenshots": {
          "type": "boolean",
          "default": true,
          "description": "Capture screenshots during recording"
        },
        "automationStudio.report.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open reports after generation"
        },
        "automationStudio.ai.provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "gemini",
            "azure",
            "openrouter",
            "ollama",
            "none"
          ],
          "default": "none",
          "description": "AI provider for code generation"
        },
        "automationStudio.ai.model": {
          "type": "string",
          "default": "",
          "description": "AI model name"
        },
        "automationStudio.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable anonymous telemetry"
        }
      }
    }
  },
